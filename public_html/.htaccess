# PERF website - Apache / LiteSpeed configuration (Hostinger)
Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

RewriteEngine On

# Force HTTPS and drop "www." (activate the free SSL in hPanel first)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old links from the first draft (about.html, index.php, about.php ...) -> clean URLs
RewriteRule ^index\.(?:html|php)$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(about|services|gallery|why-perf|faqs|contact)\.(?:html|php)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# Clean URLs: /about -> about.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

# Never serve private folders or dotfiles
RewriteRule ^(includes|storage)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Caching: assets are versioned (?v=...) so they can be cached for a long time
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
